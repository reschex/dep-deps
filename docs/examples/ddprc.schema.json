{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DDP Configuration",
  "description": "Configuration for Dependable Dependencies analysis",
  "type": "object",
  "properties": {
    "maxFiles": {
      "type": "number",
      "description": "Maximum number of files to analyze",
      "default": 400,
      "minimum": 1
    },
    "fileFilter": {
      "type": "object",
      "description": "File discovery and exclusion options",
      "properties": {
        "respectGitignore": {
          "type": "boolean",
          "description": "When true, files matched by .gitignore are excluded from analysis",
          "default": false
        },
        "excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns for files/folders to exclude (case-insensitive). Empty by default — test files are analyzed unless excluded explicitly. Examples: \"**/*.test.*\", \"**/__tests__/**\", \"**/*Test.java\".",
          "default": []
        }
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "lcovGlob": {
          "type": "string",
          "description": "Glob pattern for LCOV coverage files",
          "default": "**/coverage/lcov.info"
        },
        "jacocoGlob": {
          "type": "string",
          "description": "Glob pattern for JaCoCo coverage XML files",
          "default": "**/jacoco.xml"
        }
      }
    },
    "cc": {
      "type": "object",
      "description": "Cyclomatic complexity tool configuration",
      "properties": {
        "useEslintForTsJs": {
          "type": "boolean",
          "description": "Use ESLint complexity plugin for TypeScript/JavaScript",
          "default": true
        },
        "eslintPath": {
          "type": "string",
          "description": "Path to ESLint executable",
          "default": "eslint"
        },
        "pythonPath": {
          "type": "string",
          "description": "Path to Python executable (for Radon)",
          "default": "python"
        },
        "pmdPath": {
          "type": "string",
          "description": "Path to PMD executable (for Java)",
          "default": "pmd"
        }
      }
    },
    "rank": {
      "type": "object",
      "description": "PageRank computation parameters",
      "properties": {
        "maxIterations": {
          "type": "number",
          "description": "Maximum PageRank iterations",
          "default": 100,
          "minimum": 1
        },
        "epsilon": {
          "type": "number",
          "description": "Convergence threshold for PageRank",
          "default": 1e-6,
          "minimum": 0,
          "exclusiveMinimum": true
        }
      }
    },
    "fileRollup": {
      "type": "string",
      "enum": ["max", "sum"],
      "description": "How to aggregate symbol risks to file level",
      "default": "max"
    },
    "debug": {
      "type": "boolean",
      "description": "Enable debug logging (verbose file discovery and symbol extraction)",
      "default": false
    },
    "churn": {
      "type": "object",
      "description": "Git churn analysis configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable churn-weighted risk (F' = F × G)",
          "default": false
        },
        "lookbackDays": {
          "type": "number",
          "description": "Number of days to look back for commit history",
          "default": 90,
          "minimum": 1
        }
      }
    },
    "agentIntegration": {
      "type": "object",
      "description": "AI agent integration thresholds (PreToolUse hook and MCP server)",
      "properties": {
        "warnThreshold": {
          "type": "number",
          "description": "F threshold above which agents receive a warning before editing",
          "default": 100,
          "minimum": 0
        },
        "blockThreshold": {
          "type": "number",
          "description": "F threshold above which agent edits are blocked until acknowledged",
          "default": 500,
          "minimum": 0
        },
        "skipTestFiles": {
          "type": "boolean",
          "description": "Skip risk checks for test files",
          "default": true
        },
        "skipPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns for files to skip risk checks (e.g. config, docs)",
          "default": ["**/*.json", "**/*.md", "**/*.yml"]
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Output formatting options (reserved — not yet consumed by any formatter; setting these values has no effect today)",
      "properties": {
        "topFilesCount": {
          "type": "number",
          "description": "Number of top risky files to include in summary",
          "default": 20,
          "minimum": 1
        },
        "topSymbolsCount": {
          "type": "number",
          "description": "Number of top risky symbols to include in summary",
          "default": 20,
          "minimum": 1
        },
        "riskThresholds": {
          "type": "object",
          "description": "Risk level thresholds for color coding",
          "properties": {
            "high": {
              "type": "number",
              "description": "F' threshold for high risk (red)",
              "default": 20
            },
            "medium": {
              "type": "number",
              "description": "F' threshold for medium risk (yellow)",
              "default": 10
            }
          }
        }
      }
    }
  }
}
